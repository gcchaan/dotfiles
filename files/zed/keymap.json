[
  {
    "bindings": {
      "ctrl-[": "menu::Cancel",
      "ctrl-j": "menu::SelectNext",
      "ctrl-k": "menu::SelectPrevious",
      "ctrl-_": "terminal_panel::Toggle",
      "alt-right": "editor::SelectLargerSyntaxNode",
      "alt-left": "editor::SelectSmallerSyntaxNode",
      "space a a": "agent::ToggleFocus",
      "space a t": "multi_workspace::ToggleWorkspaceSidebar",
      "space d d": "debug_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f p": [
        "projects::OpenRecent",
        {
          "create_new_window": false,
        },
      ],
      "space f r": "file_finder::Toggle",
      "space g g": "git_panel::ToggleFocus",
      "space s s": "project_symbols::Toggle",
      "space u p": "settings_profile_selector::Toggle",
    },
  },
  {
    "context": "Workspace",
    "use_key_equivalents": true,
    "bindings": {
      "space c s": "outline_panel::ToggleFocus",
      "ctrl-l": "editor::ToggleFocus",
    },
  },
  {
    "context": "ProjectPanel",
    "use_key_equivalents": true,
    "bindings": {
      "a": "project_panel::NewFile",
      "d": [
        "project_panel::Trash",
        {
          "skip_prompt": false,
        },
      ],
      "r": "project_panel::Rename",
      "o": "workspace::OpenWithSystem",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "cmd-left": [
        "editor::MoveToBeginningOfLine",
        {
          "stop_at_soft_wraps": true,
          "stop_at_indent": true,
        },
      ],
      "cmd-right": [
        "editor::MoveToEndOfLine",
        {
          "stop_at_soft_wraps": true,
        },
      ],
      "alt-left": "editor::MoveToPreviousWordStart",
      "alt-right": "editor::MoveToNextWordEnd",
      "g d": "editor::GoToDefinition",
      "g i": "editor::GoToImplementation",
      "g r": "editor::FindAllReferences",
      "g t": "editor::GoToTypeDefinition",
      "[ c": "vim::PreviousComment",
      "] c": "vim::NextComment",
      "] f": "vim::NextMethodStart",
      "] shift-f": "vim::NextMethodEnd",
      "[ f": "vim::PreviousMethodStart",
      "[ shift-f": "vim::PreviousMethodEnd",
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space c a": "editor::ToggleCodeActions",
      "space c f": "editor::Format",
      "space c r": "editor::Rename",
      "space c l": "lsp_tool::ToggleMenu",
      "space g b": "git::Blame",
      "space g d": "git::Diff",
      "space g h": "git::FileHistory",
      "space g w": "git::Worktree",
      "shift k": "editor::Hover",
      "space e": "pane::RevealInProjectPanel",
      "space b l": [
        "pane::CloseItemsToTheLeft",
        {
          "close_pinned": false,
        },
      ],
      "space b r": [
        "pane::CloseItemsToTheRight",
        {
          "close_pinned": false,
        },
      ],
      "space b d": [
        "pane::CloseActiveItem",
        {
          "close_pinned": false,
        },
      ],
      "space b o": [
        "pane::CloseOtherItems",
        {
          "close_pinned": false,
        },
      ],
      "space b p": "pane::TogglePinTab",
      "space b P": [
        "pane::CloseAllItems",
        {
          "close_pinned": false,
        },
      ],
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "space w v": "pane::SplitRight",
    },
  },
  {
    "context": "(VimControl && !menu)",
    "bindings": {
      // https://github.com/zed-industries/zed/issues/14801
      "s": "vim::HelixJumpToWord",
    },
  },
  {
    "context": "Editor && vim_mode == visual",
    "bindings": {
      "alt-up": "editor::SelectLargerSyntaxNode",
      "alt-down": "editor::SelectSmallerSyntaxNode",
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "cmd-i": "editor::ShowCompletions",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i || vim_operator == cs",
    "bindings": {
      "q": "vim::MiniQuotes",
      "b": "vim::MiniBrackets",
    },
  },
  {
    "context": "vim_operator == c",
    "bindings": {
      "s": ["vim::PushChangeSurrounds", {}],
    },
  },
  {
    "context": "vim_operator == d",
    "bindings": {
      "s": "vim::PushDeleteSurrounds",
    },
  },
  {
    "context": "vim_operator == y",
    "bindings": {
      "s": ["vim::PushAddSurrounds", {}],
    },
  },
]
