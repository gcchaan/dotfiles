// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "edit_predictions": {
    "open_ai_compatible_api": {
      "model": ""
    },
    "provider": "copilot"
  },
  "format_on_save": "off",
  "vim_mode": true,
  "vim": {
    "highlight_on_yank_duration": 1000,
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "agent": {
    "default_profile": "ask",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o",
      "enable_thinking": false
    },
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "ui_font_size": 20,
  "buffer_font_size": 23,
  "buffer_font_family": "UDEV Gothic NF",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "cursor_blink": false,
  "code_lens": "on",
  "profiles": {
    "Presentation": {
      "settings": {
        "buffer_font_size": 25,
        "ui_font_size": 22,
        "theme": "One Light",
      },
    },
  },
}
